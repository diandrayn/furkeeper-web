# Salin ke .env lalu isi nilainya
# Project Settings → API → Project URL & anon/public key
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# OPSIONAL — tujuan tautan konfirmasi email (emailRedirectTo).
# Defaultnya window.location.origin (tempat user daftar). Isi kalau URL
# produksi beda dari tempat daftar (mis. daftar dari preview Vercel/Netlify
# tapi link konfirmasi harus balik ke domain utama). URL ini WAJIB juga
# terdaftar di Supabase → Authentication → URL Configuration → Redirect URLs.
VITE_SITE_URL=https://app.furkeeper.id