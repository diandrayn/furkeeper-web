generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model profiles {
  id                        String                      @id @db.Char(36)
  full_name                 String?                     @db.Text
  phone                     String?                     @db.Text
  avatar_url                String?                     @db.Text
  role                      profiles_role               @default(buyer)
  seller_status             profiles_seller_status      @default(none)
  provider_status           profiles_provider_status    @default(none)
  business                  Json?
  partner_submitted_at      DateTime?
  created_at                DateTime                    @default(now())
  updated_at                DateTime                    @updatedAt
  is_suspended              Boolean                     @default(false)
  suspended_reason          String?                     @db.Text
  email                     String?                     @unique @db.VarChar(255)
  password_hash             String?                     @db.Text
  session_version           Int                         @default(0)
  email_verified_at         DateTime?
  admin_scope               profiles_admin_scope        @default(full)
  addresses                 addresses[]
  bookings                  bookings[]                  @relation("buyer_bookings")
  buyer_conversations       conversations[]             @relation("buyer_conversations")
  email_verification_tokens email_verification_tokens[]
  help_messages_replied     help_messages[]             @relation("help_messages_replied")
  help_messages_user        help_messages[]             @relation("help_messages_user")
  messages                  messages[]
  notifications             notifications[]
  orders                    orders[]
  partner_applications      partner_applications[]
  password_reset_tokens     password_reset_tokens[]
  pets                      pets[]
  platform_content_updated  platform_content[]
  platform_settings_updated platform_settings[]
  reviewed_products         products[]                  @relation("products_reviewed_by")
  report_messages           report_messages[]
  reports_reported_user     reports[]                   @relation("reports_reported_user")
  reports_reporter          reports[]                   @relation("reports_reporter")
  reviews                   reviews[]
  reviewed_services         services[]                  @relation("services_reviewed_by")
  stores                    stores[]
  withdrawal_processed      withdrawals[]               @relation("withdrawal_processed_by")

  @@map("profiles")
}

model password_reset_tokens {
  id         String    @id @default(uuid()) @db.Char(36)
  user_id    String    @db.Char(36)
  token_hash String    @unique @db.VarChar(255)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  profile    profiles  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("password_reset_tokens")
}

model email_verification_tokens {
  id         String    @id @default(uuid()) @db.Char(36)
  user_id    String    @db.Char(36)
  token_hash String    @unique @db.VarChar(255)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  profile    profiles  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("email_verification_tokens")
}

model addresses {
  id             String   @id @default(uuid()) @db.Char(36)
  user_id        String   @db.Char(36)
  label          String   @db.VarChar(255)
  recipient_name String   @db.VarChar(255)
  phone          String   @db.VarChar(255)
  full_address   String   @db.Text
  city           String?  @db.VarChar(255)
  district       String?  @db.VarChar(255)
  postal_code    String?  @db.VarChar(255)
  is_default     Boolean  @default(false)
  created_at     DateTime @default(now())
  profile        profiles @relation(fields: [user_id], references: [id], onDelete: Cascade)
  orders         orders[]

  @@index([user_id])
  @@map("addresses")
}

model pets {
  id         String     @id @default(uuid()) @db.Char(36)
  owner_id   String     @db.Char(36)
  name       String     @db.VarChar(255)
  species    String     @db.VarChar(255)
  breed      String?    @db.VarChar(255)
  age        String?    @db.VarChar(255)
  weight     String?    @db.VarChar(255)
  notes      String?    @db.Text
  photo_url  String?    @db.Text
  created_at DateTime   @default(now())
  bookings   bookings[]
  profile    profiles   @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  @@index([owner_id])
  @@map("pets")
}

model stores {
  id              String          @id @default(uuid()) @db.Char(36)
  owner_id        String          @db.Char(36)
  kind            stores_kind
  name            String          @db.VarChar(255)
  description     String?         @db.Text
  tagline         String?         @db.VarChar(255)
  category        String?         @db.VarChar(255)
  location        String?         @db.VarChar(255)
  district        String?         @db.VarChar(255)
  city            String?         @db.VarChar(255)
  phone           String?         @db.VarChar(255)
  email           String?         @db.VarChar(255)
  address         String?         @db.Text
  home_service    Boolean         @default(false)
  is_open         Boolean         @default(true)
  operating_hours Json            @default("[]")
  logo_url        String?         @db.Text
  banner_url      String?         @db.Text
  trusted         Boolean         @default(false)
  fast_response   Boolean         @default(false)
  rating          Decimal?        @default(0.0) @db.Decimal(2, 1)
  slug            String?         @unique @db.VarChar(255)
  store_policy    String?         @db.Text
  created_at      DateTime        @default(now())
  conversations   conversations[]
  order_items     order_items[]
  products        products[]
  reports         reports[]
  services        services[]
  profile         profiles        @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  withdrawals     withdrawals[]

  @@index([owner_id])
  @@index([district])
  @@map("stores")
}

model product_categories {
  id         String               @id @default(uuid()) @db.Char(36)
  parent_id  String?              @db.Char(36)
  name       String               @db.VarChar(255)
  sort_order Int                  @default(0)
  created_at DateTime             @default(now())
  parent     product_categories?  @relation("product_categories_parent", fields: [parent_id], references: [id], onDelete: Cascade)
  children   product_categories[] @relation("product_categories_parent")

  @@index([parent_id, sort_order])
  @@map("product_categories")
}

model service_categories {
  id         String               @id @default(uuid()) @db.Char(36)
  parent_id  String?              @db.Char(36)
  name       String               @db.VarChar(255)
  sort_order Int                  @default(0)
  created_at DateTime             @default(now())
  parent     service_categories?  @relation("service_categories_parent", fields: [parent_id], references: [id], onDelete: Cascade)
  children   service_categories[] @relation("service_categories_parent")

  @@index([parent_id, sort_order])
  @@map("service_categories")
}

model products {
  id               String                   @id @default(uuid()) @db.Char(36)
  store_id         String                   @db.Char(36)
  name             String                   @db.VarChar(255)
  category         String                   @db.VarChar(255)
  pet_type         String                   @db.VarChar(255)
  description      String?                  @db.Text
  price            Int
  original_price   Int?
  discount_percent Int?
  variants         Json                     @default("[]")
  badge            String?                  @db.VarChar(255)
  image_url        String?                  @db.Text
  images           Json?
  stock            Int                      @default(0)
  rating           Decimal?                 @default(0.0) @db.Decimal(2, 1)
  sold_count       Int                      @default(0)
  is_active        Boolean                  @default(true)
  approval_status  products_approval_status @default(pending)
  rejection_reason String?                  @db.Text
  reviewed_by      String?                  @db.Char(36)
  reviewed_at      DateTime?
  created_at       DateTime                 @default(now())
  order_items      order_items[]
  reviewer         profiles?                @relation("products_reviewed_by", fields: [reviewed_by], references: [id])
  store            stores                   @relation(fields: [store_id], references: [id], onDelete: Cascade)
  reviews          reviews[]

  @@index([store_id])
  @@index([approval_status])
  @@index([reviewed_by], map: "products_reviewed_by_fkey")
  @@map("products")
}

model services {
  id                   String                   @id @default(uuid()) @db.Char(36)
  store_id             String                   @db.Char(36)
  name                 String                   @db.VarChar(255)
  service_type         String                   @db.VarChar(255)
  description          String?                  @db.Text
  price_from           Int
  duration             String?                  @db.VarChar(255)
  booked_count         Int                      @default(0)
  distance_or_location String?                  @db.VarChar(255)
  image_url            String?                  @db.Text
  rating               Decimal?                 @default(0.0) @db.Decimal(2, 1)
  review_count         Int                      @default(0)
  is_active            Boolean                  @default(true)
  approval_status      services_approval_status @default(pending)
  rejection_reason     String?                  @db.Text
  reviewed_by          String?                  @db.Char(36)
  reviewed_at          DateTime?
  created_at           DateTime                 @default(now())
  bookings             bookings[]
  reviews              reviews[]
  packages             service_packages[]
  reviewer             profiles?                @relation("services_reviewed_by", fields: [reviewed_by], references: [id])
  store                stores                   @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id])
  @@index([approval_status])
  @@index([reviewed_by], map: "services_reviewed_by_fkey")
  @@map("services")
}

model service_packages {
  id          String     @id @default(uuid()) @db.Char(36)
  service_id  String     @db.Char(36)
  name        String     @db.VarChar(255)
  description String?    @db.Text
  price       Int
  duration    String?    @db.VarChar(255)
  bookings    bookings[]
  service     services   @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@index([service_id])
  @@map("service_packages")
}

model payments {
  id                String          @id @default(uuid()) @db.Char(36)
  midtrans_order_id String          @unique @db.VarChar(64)
  gross_amount      Int
  status            payments_status @default(pending)
  snap_token        String?         @db.Text
  snap_redirect_url String?         @db.Text
  transaction_id    String?         @db.VarChar(255)
  payment_type      String?         @db.VarChar(255)
  fraud_status      String?         @db.VarChar(64)
  raw_notification  Json?
  paid_at           DateTime?
  expires_at        DateTime?
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  orders            orders[]

  @@index([status])
  @@map("payments")
}

model orders {
  id               String                 @id @default(uuid()) @db.Char(36)
  buyer_id         String                 @db.Char(36)
  address_id       String?                @db.Char(36)
  payment_id       String?                @db.Char(36)
  status           orders_status          @default(pending_payment)
  payment_method   String?                @db.VarChar(255)
  subtotal         Int
  shipping_cost    Int                    @default(0)
  total            Int
  tracking_number  String?                @db.VarChar(255)
  shipping_address String?                @db.Text
  created_at       DateTime               @default(now())
  items            order_items[]
  status_history   order_status_history[]
  address          addresses?             @relation(fields: [address_id], references: [id])
  payment          payments?              @relation(fields: [payment_id], references: [id])
  profile          profiles               @relation(fields: [buyer_id], references: [id], onDelete: Cascade)
  reviews          reviews[]

  @@index([buyer_id])
  @@index([address_id], map: "orders_address_id_fkey")
  @@index([payment_id])
  @@map("orders")
}

model order_items {
  id         String    @id @default(uuid()) @db.Char(36)
  order_id   String    @db.Char(36)
  product_id String?   @db.Char(36)
  store_id   String?   @db.Char(36)
  name       String    @db.VarChar(255)
  variant    String?   @db.VarChar(255)
  price      Int
  quantity   Int       @default(1)
  order      orders    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product    products? @relation(fields: [product_id], references: [id])
  store      stores?   @relation(fields: [store_id], references: [id])

  @@index([order_id])
  @@index([product_id], map: "order_items_product_id_fkey")
  @@index([store_id])
  @@map("order_items")
}

model order_status_history {
  id          String   @id @default(uuid()) @db.Char(36)
  order_id    String   @db.Char(36)
  status      String   @db.VarChar(255)
  from_status String?  @db.VarChar(255)
  to_status   String?  @db.VarChar(255)
  changed_by  String?  @db.Char(36)
  note        String?  @db.Text
  created_at  DateTime @default(now())
  order       orders   @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@map("order_status_history")
}

model bookings {
  id                 String                   @id @default(uuid()) @db.Char(36)
  buyer_id           String                   @db.Char(36)
  service_id         String                   @db.Char(36)
  service_package_id String?                  @db.Char(36)
  pet_id             String?                  @db.Char(36)
  status             bookings_status          @default(pending_confirmation)
  scheduled_date     DateTime                 @db.Date
  scheduled_time     String                   @db.VarChar(255)
  price              Int
  notes              String?                  @db.Text
  buyer_name         String?                  @db.VarChar(255)
  buyer_phone        String?                  @db.VarChar(255)
  pet_name           String?                  @db.VarChar(255)
  pet_species        String?                  @db.VarChar(255)
  created_at         DateTime                 @default(now())
  status_history     booking_status_history[]
  pet                pets?                    @relation(fields: [pet_id], references: [id])
  package            service_packages?        @relation(fields: [service_package_id], references: [id])
  service            services                 @relation(fields: [service_id], references: [id])
  buyer              profiles                 @relation("buyer_bookings", fields: [buyer_id], references: [id], onDelete: Cascade)
  reviews            reviews[]

  @@index([buyer_id])
  @@index([service_id])
  @@index([pet_id], map: "bookings_pet_id_fkey")
  @@index([service_package_id], map: "bookings_service_package_id_fkey")
  @@map("bookings")
}

model booking_status_history {
  id          String   @id @default(uuid()) @db.Char(36)
  booking_id  String   @db.Char(36)
  status      String   @db.VarChar(255)
  from_status String?  @db.VarChar(255)
  to_status   String?  @db.VarChar(255)
  changed_by  String?  @db.Char(36)
  note        String?  @db.Text
  created_at  DateTime @default(now())
  booking     bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@index([booking_id])
  @@map("booking_status_history")
}

model reviews {
  id         String    @id @default(uuid()) @db.Char(36)
  author_id  String    @db.Char(36)
  product_id String?   @db.Char(36)
  service_id String?   @db.Char(36)
  order_id   String?   @db.Char(36)
  booking_id String?   @db.Char(36)
  rating     Int
  comment    String?   @db.Text
  reply      String?   @db.Text
  created_at DateTime  @default(now())
  author     profiles  @relation(fields: [author_id], references: [id], onDelete: Cascade)
  booking    bookings? @relation(fields: [booking_id], references: [id])
  order      orders?   @relation(fields: [order_id], references: [id])
  product    products? @relation(fields: [product_id], references: [id])
  service    services? @relation(fields: [service_id], references: [id])

  @@index([author_id])
  @@index([booking_id], map: "reviews_booking_id_fkey")
  @@index([order_id], map: "reviews_order_id_fkey")
  @@index([product_id], map: "reviews_product_id_fkey")
  @@index([service_id], map: "reviews_service_id_fkey")
  @@map("reviews")
}

model conversations {
  id              String     @id @default(uuid()) @db.Char(36)
  buyer_id        String     @db.Char(36)
  store_id        String     @db.Char(36)
  context         Json?
  last_message_at DateTime   @default(now())
  created_at      DateTime   @default(now())
  buyer           profiles   @relation("buyer_conversations", fields: [buyer_id], references: [id], onDelete: Cascade)
  store           stores     @relation(fields: [store_id], references: [id], onDelete: Cascade)
  messages        messages[]

  @@unique([buyer_id, store_id])
  @@index([store_id])
  @@map("conversations")
}

model messages {
  id              String        @id @default(uuid()) @db.Char(36)
  conversation_id String        @db.Char(36)
  sender_id       String        @db.Char(36)
  content         String        @db.Text
  attachment_url  String?       @db.Text
  is_read         Boolean       @default(false)
  created_at      DateTime      @default(now())
  conversation    conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender          profiles      @relation(fields: [sender_id], references: [id])

  @@index([conversation_id])
  @@index([sender_id], map: "messages_sender_id_fkey")
  @@map("messages")
}

model notifications {
  id         String   @id @default(uuid()) @db.Char(36)
  user_id    String   @db.Char(36)
  type       String   @db.VarChar(255)
  title      String   @db.VarChar(255)
  body       String?  @db.Text
  link       String?  @db.Text
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
  profile    profiles @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("notifications")
}

model partner_applications {
  id               String                      @id @default(uuid()) @db.Char(36)
  user_id          String                      @db.Char(36)
  type             partner_applications_type
  business_name    String                      @db.VarChar(255)
  documents        Json?
  status           partner_applications_status @default(pending)
  rejection_reason String?                     @db.Text
  submitted_at     DateTime                    @default(now())
  reviewed_at      DateTime?
  profile          profiles                    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("partner_applications")
}

model withdrawals {
  id             String             @id @default(uuid()) @db.Char(36)
  store_id       String             @db.Char(36)
  amount         Int
  bank_name      String             @db.VarChar(255)
  account_number String             @db.VarChar(255)
  account_holder String             @db.VarChar(255)
  status         withdrawals_status @default(pending)
  admin_note     String?            @db.Text
  created_at     DateTime           @default(now())
  processed_at   DateTime?
  processed_by   String?            @db.Char(36)
  processor      profiles?          @relation("withdrawal_processed_by", fields: [processed_by], references: [id])
  store          stores             @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id])
  @@index([status])
  @@index([processed_by], map: "withdrawals_processed_by_fkey")
  @@map("withdrawals")
}

model reports {
  id                String            @id @default(uuid()) @db.Char(36)
  reporter_id       String            @db.Char(36)
  reported_user_id  String?           @db.Char(36)
  reported_store_id String?           @db.Char(36)
  category          reports_category
  description       String            @db.Text
  priority          reports_priority  @default(normal)
  status            reports_status    @default(baru)
  order_id          String?           @db.Char(36)
  booking_id        String?           @db.Char(36)
  product_id        String?           @db.Char(36)
  service_id        String?           @db.Char(36)
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  messages          report_messages[]
  reported_store    stores?           @relation(fields: [reported_store_id], references: [id], onDelete: Cascade)
  reported_user     profiles?         @relation("reports_reported_user", fields: [reported_user_id], references: [id], onDelete: Cascade)
  reporter          profiles          @relation("reports_reporter", fields: [reporter_id], references: [id], onDelete: Cascade)

  @@index([reporter_id])
  @@index([status])
  @@index([reported_store_id], map: "reports_reported_store_id_fkey")
  @@index([reported_user_id], map: "reports_reported_user_id_fkey")
  @@map("reports")
}

model report_messages {
  id         String   @id @default(uuid()) @db.Char(36)
  report_id  String   @db.Char(36)
  sender_id  String   @db.Char(36)
  is_admin   Boolean  @default(false)
  body       String   @db.Text
  created_at DateTime @default(now())
  report     reports  @relation(fields: [report_id], references: [id], onDelete: Cascade)
  sender     profiles @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([report_id])
  @@index([sender_id], map: "report_messages_sender_id_fkey")
  @@map("report_messages")
}

model help_messages {
  id          String               @id @default(uuid()) @db.Char(36)
  user_id     String?              @db.Char(36)
  name        String               @db.VarChar(255)
  email       String               @db.VarChar(255)
  subject     String?              @db.VarChar(255)
  body        String               @db.Text
  status      help_messages_status @default(belum_dibalas)
  admin_reply String?              @db.Text
  replied_by  String?              @db.Char(36)
  replied_at  DateTime?
  created_at  DateTime             @default(now())
  updated_at  DateTime             @updatedAt
  replier     profiles?            @relation("help_messages_replied", fields: [replied_by], references: [id])
  user        profiles?            @relation("help_messages_user", fields: [user_id], references: [id])

  @@index([status])
  @@index([replied_by], map: "help_messages_replied_by_fkey")
  @@index([user_id], map: "help_messages_user_id_fkey")
  @@map("help_messages")
}

model faqs {
  id           String   @id @default(uuid()) @db.Char(36)
  category     String   @default("Umum") @db.VarChar(255)
  question     String   @db.Text
  answer       String   @db.Text
  sort_order   Int      @default(0)
  is_published Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  updated_by   String?  @db.Char(36)

  @@map("faqs")
}

model platform_content {
  key        String    @id @db.VarChar(255)
  title      String    @db.VarChar(255)
  body       String    @default("") @db.Text
  updated_at DateTime  @updatedAt
  updated_by String?   @db.Char(36)
  updater    profiles? @relation(fields: [updated_by], references: [id])

  @@index([updated_by], map: "platform_content_updated_by_fkey")
  @@map("platform_content")
}

model platform_settings {
  id                        Int       @id @default(1)
  commission_produk_percent Decimal   @default(5.00) @db.Decimal(5, 2)
  commission_jasa_percent   Decimal   @default(10.00) @db.Decimal(5, 2)
  updated_at                DateTime  @updatedAt
  updated_by                String?   @db.Char(36)
  updater                   profiles? @relation(fields: [updated_by], references: [id])

  @@index([updated_by], map: "platform_settings_updated_by_fkey")
  @@map("platform_settings")
}

model admin_activity_log {
  id           String   @id @default(uuid()) @db.Char(36)
  actor_id     String?  @db.Char(36)
  actor_name   String?  @db.VarChar(255)
  action       String   @db.VarChar(255)
  action_label String   @db.VarChar(255)
  target_type  String   @db.VarChar(255)
  target_id    String?  @db.Char(36)
  target_label String?  @db.Text
  detail       Json?
  created_at   DateTime @default(now())

  @@index([created_at])
  @@map("admin_activity_log")
}

enum profiles_admin_scope {
  full
  approval
  support
}

enum profiles_role {
  buyer
  seller
  service
  admin
}

enum profiles_seller_status {
  none
  pending
  approved
  rejected
}

enum profiles_provider_status {
  none
  pending
  approved
  rejected
}

enum stores_kind {
  seller
  service
}

enum products_approval_status {
  pending
  approved
  rejected
}

